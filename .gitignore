# ── Build & Output Directories ───────────────────────────────────────────────
/build/
/Build/
/build-*/
/bin/
/lib/

# ── CMake ────────────────────────────────────────────────────────────────────
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile               # Generated by CMake primarily on Linux/macOS (Makefiles)
install_manifest.txt
compile_commands.json  # Used by clangd and Linux/macOS tools for code completion
Testing/               # CTest output directory

# ── Dependencies (vcpkg) ─────────────────────────────────────────────────────
vcpkg_installed/
.cache/

# ── Compiled Artifacts ───────────────────────────────────────────────────────
*.exe       # Windows executables
*.out       # Linux standard executables (e.g. a.out)
*.app       # macOS application bundles
*.slo
*.lo
*.o         # Linux/macOS compiled object files
*.obj       # Windows compiled object files
*.gch       # Precompiled headers (GCC/Linux)
*.pch       # Precompiled headers (Clang/MSVC)
*.ilk       # Windows incremental linker files
*.pdb       # Windows debug symbols
*.dwo       # Linux split debug information files
*.so        # Linux shared libraries
*.dylib     # macOS shared libraries
*.dll       # Windows shared libraries
*.so.*      # Linux versioned shared libraries (e.g. libabc.so.1)
*.lai
*.la        # libtool archives (Linux/macOS)
*.a         # Linux/macOS static libraries
*.lib       # Windows static libraries
*.d         # Make/GCC dependency tracking files
*.mod       
*.smod

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vs/        # Visual Studio folder
.vscode/    # VS Code folder
.idea/      # JetBrains IDEs (CLion)
*.user
*.suo
*.sln       # Visual Studio solution
*.vcxproj
*.vcxproj.filters
*.swp       # Vim swap file (Linux/macOS terminal editors)
*.swo       # Vim swap file
*~          # Emacs/Vim backup file
*.bak

# ── OS & Temporary Files ─────────────────────────────────────────────────────
.DS_Store   # macOS folder custom attributes and metadata
Thumbs.db   # Windows image thumbnail cache
desktop.ini # Windows folder layout settings
*.tmp
*.log
