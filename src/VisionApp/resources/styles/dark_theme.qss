/* ═══════════════════════════════════════════════════════════════════════════
   Vision Studio — Dark Theme
   A modern, premium dark UI with accent colours and smooth transitions.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────────────────── */

* {
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f0f1a;
}

QWidget {
    background-color: #0f0f1a;
    color: #e0e0e0;
}

/* ── Menu Bar ────────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #16162b;
    color: #c8c8d0;
    border-bottom: 1px solid #2a2a4a;
    padding: 2px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenuBar::item:selected {
    background-color: #2a2a50;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #3a3a60;
}

/* ── Menus ────────────────────────────────────────────────────────────────── */

QMenu {
    background-color: #1a1a35;
    border: 1px solid #2a2a50;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu::item {
    padding: 8px 32px 8px 24px;
    margin: 2px 6px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2e4a8a;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #2a2a50;
    margin: 4px 12px;
}

/* ── Tool Bar ────────────────────────────────────────────────────────────── */

QToolBar {
    background-color: #16162b;
    border-bottom: 1px solid #2a2a4a;
    padding: 4px 8px;
    spacing: 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #2a2a4a;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #c8c8d0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    margin: 1px;
}

QToolButton:hover {
    background-color: #2a2a50;
    border-color: #3a3a60;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #2e4a8a;
}

QToolButton:disabled {
    color: #505060;
}

/* ── Status Bar ──────────────────────────────────────────────────────────── */

QStatusBar {
    background-color: #12122a;
    color: #8888a0;
    border-top: 1px solid #2a2a4a;
    padding: 2px 8px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ── Dock Widgets ────────────────────────────────────────────────────────── */

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    color: #b0b0c0;
    font-weight: bold;
    font-size: 12px;
}

QDockWidget::title {
    background-color: #16162b;
    padding: 8px 12px;
    border-bottom: 1px solid #2a2a4a;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #2a2a50;
    border-radius: 3px;
}

/* ── Scroll Bars ─────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background-color: #0f0f1a;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #2a2a50;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3a3a70;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0f0f1a;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #2a2a50;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3a3a70;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #2a2a50;
    color: #e0e0e0;
    border: 1px solid #3a3a60;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3a3a70;
    border-color: #4a4a80;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #2e4a8a;
}

QPushButton:disabled {
    background-color: #1a1a30;
    color: #505060;
    border-color: #252540;
}

/* ── Primary Action Button (use with setProperty("class", "primary")) ──── */

QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #2e5aaa, stop:1 #4a70cc);
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #3a6abb, stop:1 #5a80dd);
}

QPushButton[class="primary"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #244a8a, stop:1 #3a60bb);
}

/* ── Line Edit ───────────────────────────────────────────────────────────── */

QLineEdit {
    background-color: #1a1a35;
    color: #e0e0e0;
    border: 1px solid #2a2a50;
    border-radius: 6px;
    padding: 6px 12px;
    selection-background-color: #2e4a8a;
}

QLineEdit:focus {
    border-color: #3a6abb;
}

/* ── Combo Box ───────────────────────────────────────────────────────────── */

QComboBox {
    background-color: #1a1a35;
    color: #e0e0e0;
    border: 1px solid #2a2a50;
    border-radius: 6px;
    padding: 6px 12px;
}

QComboBox:hover {
    border-color: #3a3a60;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1a1a35;
    color: #e0e0e0;
    border: 1px solid #2a2a50;
    border-radius: 6px;
    selection-background-color: #2e4a8a;
}

/* ── Check Box ───────────────────────────────────────────────────────────── */

QCheckBox {
    color: #e0e0e0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3a3a60;
    border-radius: 4px;
    background-color: #1a1a35;
}

QCheckBox::indicator:checked {
    background-color: #2e5aaa;
    border-color: #3a6abb;
}

QCheckBox::indicator:hover {
    border-color: #4a70cc;
}

/* ── Group Box ───────────────────────────────────────────────────────────── */

QGroupBox {
    border: 1px solid #2a2a50;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 600;
    color: #a0a0c0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #b0b0d0;
}

/* ── Tab Widget ──────────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #0f0f1a;
    border: 1px solid #2a2a50;
    border-radius: 0 0 8px 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #16162b;
    color: #8888a0;
    border: 1px solid #2a2a50;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 8px 18px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f0f1a;
    color: #ffffff;
    border-bottom: 2px solid #2e5aaa;
}

QTabBar::tab:hover:!selected {
    background-color: #1e1e3a;
    color: #c0c0d0;
}

/* ── Tooltip ─────────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #1a1a35;
    color: #e0e0e0;
    border: 1px solid #2a2a50;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Progress Bar ────────────────────────────────────────────────────────── */

QProgressBar {
    background-color: #1a1a35;
    border: 1px solid #2a2a50;
    border-radius: 6px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2e5aaa, stop:1 #4a70cc);
    border-radius: 5px;
}

/* ── Splitter ────────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #2a2a4a;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ── Message Box ─────────────────────────────────────────────────────────── */

QMessageBox {
    background-color: #16162b;
}

QMessageBox QLabel {
    color: #e0e0e0;
}

/* ── File Dialog ─────────────────────────────────────────────────────────── */

QHeaderView::section {
    background-color: #16162b;
    color: #b0b0c0;
    border: none;
    border-right: 1px solid #2a2a4a;
    padding: 6px 12px;
    font-weight: 600;
}
