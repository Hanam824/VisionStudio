{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "vision-studio",
    "version-semver": "0.1.0",
    "description": "Cross-platform OCR & Image Processing Studio",
    "$comment": "TODO: ncnn is commented out for now, but will be used in the future.",
    "dependencies": [
        {
            "name": "libjpeg-turbo",
            "default-features": false,
            "features": ["jpeg8"]
        },
        {
            "name": "opencv4",
            "default-features": false,
            "features": ["jpeg", "png", "tiff", "webp"]
        },
        {
            "name": "qtbase",
            "default-features": false,
            "features": ["widgets", "concurrent", "jpeg", "png"]
        },
        "gtest"
    ],
    "overrides": [],
    "builtin-baseline": "14da8d976f119dfcab9853755f92f6f388dc808b"
}
